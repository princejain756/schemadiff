{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/user-v2.json",
  "title": "User",
  "type": "object",
  "required": ["id", "name", "email"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "name": {
      "type": "string",
      "maxLength": 32
    },
    "email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": ["admin", "user"]
    },
    "tags": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
