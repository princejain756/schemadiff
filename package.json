{
  "name": "schemadiff",
  "version": "0.4.0",
  "description": "Compare two JSON Schema documents and report breaking changes",
  "keywords": [
    "json-schema",
    "schema",
    "diff",
    "breaking-changes",
    "ci"
  ],
  "license": "MIT",
  "author": "schemadiff contributors",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "schemadiff": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3"
  }
}
